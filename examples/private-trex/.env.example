# Alchemy API key for Sepolia testnet
ALCHEMY_API_KEY=

# BIP32 wallet seed (hex-encoded, 32 bytes).
# All actor addresses are derived from this seed via BIP-44 (m/44'/60'/...).
# Same seed = same deployer address on any machine.
#
# Funding:
#   1. Run start-sepolia.sh once — it will print the deployer address.
#   2. Send Sepolia ETH to that address (~5 ETH for deploy + multiple demo runs).
#   3. The demo auto-distributes ETH from deployer to actor wallets.
#
# Cost estimate:
#   Infrastructure deploy (one-time): ~0.5-1 ETH
#   Per demo run: ~0.5-0.8 ETH (T-REX + Zeto + transfers + ZK proofs)
WALLET_SEED=

# API server settings
# API_PORT=3001
# API_KEY=your-secret-key-here   # Set this to protect the API on a public VM
